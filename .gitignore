# Documentation
site/
docs/_build/
marimo/_static/
marimo/_lsp/
__marimo__/

# -------------------------------------------------------------
# Project-specific data
# -------------------------------------------------------------
pc/data_files/*
!pc/data_files/firebase_config.example.json

# Firebase configuration is machine/account specific. Keep only the committed
# example file; never commit API keys, service credentials, or user tokens.
pc/data_files/firebase_config.json
android/app/google-services.json
firebase-adminsdk-*.json
*.firebase-token

# Local Gradle caches/downloads created for builds and troubleshooting.
android/.gradle-user/
android/.gradle-verify/
android/.gradle-windows-trust/
android/gradle-*-bin.zip
# -------------------------------------------------------------
# Android / mobile build artifacts
# -------------------------------------------------------------
android/.gradle/
android/.idea/
android/.kotlin/
android/.cxx/
android/.externalNativeBuild/
android/local.properties
android/**/build/
android/**/generated/
android/**/intermediates/
android/**/outputs/
android/**/captures/
android/**/*.apk
android/**/*.ap_
android/**/*.aab
android/**/*.aar
android/**/*.jks
android/**/*.keystore

# Gradle wrapper internals generated on demand
.gradle/
